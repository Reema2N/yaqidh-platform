# Copy this file to .env and fill in your own values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Riyadh

# Database: "mysql" (shared with the detection pipeline) or "sqlite" (quick local demo)
DB_ENGINE=mysql
DB_NAME=violence_system_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Folder where the detection pipeline stores evidence images/clips
MEDIA_ROOT=

# Email for OTP / account emails (Gmail needs an App Password).
# Leave EMAIL_HOST_USER empty to print emails in the terminal instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Verification code lifetime in minutes (0 = never expires) and max wrong attempts
OTP_EXPIRY_MINUTES=1440
OTP_MAX_ATTEMPTS=5
